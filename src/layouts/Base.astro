---
interface Props {
  title: string;
  description?: string;
  og?: { title?: string; description?: string };
  /* Carte Open Graph : chemin relatif dans /og, généré au build par
     scripts/og/gen-og.mjs. Sans valeur, la carte générique du blog. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Journal de bord technique — homelab, infra, IA et apprentissage en continu.',
  og,
  ogImage = '/og/default.png',
  ogImageAlt,
  ogType = 'website',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Absolue et obligatoire : un og:image relatif n'est suivi par aucun crawler.
const ogImageUrl = new URL(ogImage, Astro.site);
const ogTitle = og?.title ?? title;
const ogDescription = og?.description ?? description;
const ogAlt = ogImageAlt ?? `Carte pixelium // blog — ${ogTitle}`;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="pixelium // blog" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=jetbrains-mono:400,500,600,700|inter:400,500,600,700,800" rel="stylesheet" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="pixelium // blog" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ferr079" />
    <meta name="twitter:creator" content="@ferr079" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      console.log(
        '%c ██████╗ ██╗██╗  ██╗███████╗██╗     ██╗██╗   ██╗███╗   ███╗\n██╔══██╗██║╚██╗██╔╝██╔════╝██║     ██║██║   ██║████╗ ████║\n██████╔╝██║ ╚███╔╝ █████╗  ██║     ██║██║   ██║██╔████╔██║\n██╔═══╝ ██║ ██╔██╗ ██╔══╝  ██║     ██║██║   ██║██║╚██╔╝██║\n██║     ██║██╔╝ ██╗███████╗███████╗██║╚██████╔╝██║ ╚═╝ ██║\n╚═╝     ╚═╝╚═╝  ╚═╝╚══════╝╚══════╝╚═╝ ╚═════╝ ╚═╝     ╚═╝',
        'color: #38bdf8; font-size: 6px; line-height: 1.1;'
      );
      console.log('%c// blog — construit en binome, un humain curieux et une IA obstinee.', 'color: #94a3b8; font-family: monospace;');
      console.log('%cTu fouilles les devtools ? Bonne mentalite. %chttps://pixelium.win', 'color: #e2e8f0;', 'color: #38bdf8;');

      const reveals = document.querySelectorAll('.reveal');
      if (reveals.length) {
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
        }, { threshold: 0.12 });
        reveals.forEach((el) => obs.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0a0f1a;
    --color-bg-soft: #0f172a;
    --color-surface: #1e293b;
    --color-surface-hover: #263548;
    --color-border: #334155;
    --color-border-subtle: #1e293b;
    --color-text: #e2e8f0;
    --color-text-muted: #94a3b8;
    --color-text-faint: #64748b;
    --color-accent: #38bdf8;
    --color-accent-hover: #7dd3fc;
    --color-accent-dim: rgba(56, 189, 248, 0.08);
    --color-accent-glow: rgba(56, 189, 248, 0.15);
    --color-green: #22c55e;
    --color-red: #ef4444;
    --color-yellow: #eab308;
    --font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, monospace;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --max-width: 72rem;
    --content-width: 52rem;
    --radius: 8px;
    --radius-sm: 4px;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
    background: var(--color-bg);
    min-height: 100vh;
  }

  a { color: var(--color-accent); text-decoration: none; transition: color 0.2s; }
  a:hover { color: var(--color-accent-hover); }

  ::selection { background: rgba(56, 189, 248, 0.25); color: #fff; }

  img { max-width: 100%; height: auto; border-radius: var(--radius); }

  .reveal { opacity: 0; transform: translateY(1.2rem); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
  .reveal.visible { opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>
